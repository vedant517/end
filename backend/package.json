{
  "name": "ecommerce-backend-unified",
  "version": "1.0.0",
  "description": "Unified backend for User and Admin sides",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "postinstall": "npm install --prefix ../frontend && npm run build --prefix ../frontend",
    "start": "node --dns-result-order=ipv4first server.js",
    "dev": "nodemon --dns-result-order=ipv4first server.js",
    "seed": "node admin/seedAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.5",
    "razorpay": "^2.9.6",
    "slugify": "^1.6.9",
    "stripe": "^22.0.0"
