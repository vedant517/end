# Server
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/adminsaree

# JWT (required)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Email OTP (required for email login)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Optional SMTP overrides (defaults to Gmail-style)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=Sheetalya <your-email@gmail.com>

# CORS / Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost:3000,https://admin.sheetalya.com,http://admin.sheetalya.com
